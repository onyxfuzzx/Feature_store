# Feature Store - Environment Configuration
# Copy this file to backend/.env and fill in your Supabase credentials

# Supabase PostgreSQL Connection URL
# Format: postgresql+psycopg2://[db-user].[project-ref]:[db-password]@[host]:[port]/[db-name]
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string (Python/SQLAlchemy)
DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxxxxxxxxxxxxxx:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Default Admin Account (seeded on first run)
ADMIN_NAME=FeatureOps Admin
ADMIN_EMAIL=admin@featureops.local
ADMIN_PASSWORD=ChangeMe123!

# App settings
APP_NAME=Feature Store
APP_ENV=local

# Source SQL uses a separate login; configure and provision it before serving queries.
SOURCE_DATABASE_URL=postgresql+psycopg2://featureops_source:REPLACE_READER_PASSWORD@localhost:5432/feature_store
SOURCE_ALLOWED_TABLES=feature_store.sample_events
SOURCE_QUERY_TIMEOUT_MS=5000
SOURCE_MAX_ROWS=100000
ONLINE_STORE_BACKEND=postgres
REDIS_URL=redis://localhost:6379/0
SEED_DEMO_DATA=false
